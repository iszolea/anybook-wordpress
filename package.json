{
	"name": "anybook-wordpress",
	"version": "0.1.1",
	"private": true,
	"description": "Build tools for the Anybook Online Booking plugin: the Anybook booking block (blocks/booking, built to build/).",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=blocks --output-path=build",
		"lint:js": "wp-scripts lint-js blocks",
		"test:unit": "wp-scripts test-unit-js blocks",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"plugin-zip": "wp-scripts plugin-zip",
		"lint:style": "wp-scripts lint-style \"blocks/**/*.scss\""
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "30.27.0",
		"typescript": "~5.9.3"
	},
	"overrides": {
		"typescript": "~5.9.3"
	}
}
